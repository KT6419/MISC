<script>
  window.appcuesGTMPackage = {
    initializeAppcuesMP: () => {
  try {
    // Inject CSS first
    const css = `
      appcues-container {
        border-radius: 8px !important;
      }
      appcues-container[data-pattern-type=shorty][data-position="bottom"] {
        margin-left: 100px !important;
        bottom: 50px !important;
      }
   
    `;
    const style = document.createElement('style');
    style.type = 'text/css';
    style.innerHTML = css;
    document.head.appendChild(style);

    // Execute main script
    const scriptContent = `
      (function() {
        var injectCSS = function(css) {
          var style = document.createElement('style');
          style.type = 'text/css';
          style.innerHTML = css;
          document.head.appendChild(style);
        }
        
        // URL manipulation function
        function buildFilteredURL() {
          var url = window.location.href;
          var resultUrl = url;

          // Extract and preserve any hash fragment
          var hashFragment = '';
          if (resultUrl.indexOf('#') !== -1) {
            hashFragment = resultUrl.substring(resultUrl.indexOf('#'));
            resultUrl = resultUrl.substring(0, resultUrl.indexOf('#'));
          }

          // Remove extra_fast=true from query
          resultUrl = resultUrl.replace(/([?&])extra_fast=true(&)?/gi, function(match, p1, p2) {
            return p1 === '?' && !p2 ? '' : (p2 ? p1 : '');
          }).replace(/[&?]+$/, '');

          // Clean filters with trailing pipe (filters=xxx|)
          resultUrl = resultUrl.replace(/([?&])filters=([^&]*?)\\|(&|$)/gi, function(match, p1, p2, p3) {
            return p2 ? p1 + 'filters=' + encodeURIComponent(p2) + (p3 === '&' ? '&' : '') : '';
          });

          // Decode clean version for logic checks
          var decodedCleanUrl = decodeURIComponent(resultUrl);
          var hasRef = /[?&]ref=/i.test(decodedCleanUrl);
          var hasDelivery = /ref=.*delivery_time:1/i.test(decodedCleanUrl);
          var hasTopRated = /ref=.*seller_level:top_rated_seller/i.test(decodedCleanUrl);

          // Helper to append to existing or new ref
          function appendToRef(newPart) {
            var refMatch = resultUrl.match(/([?&])ref=([^&]*)/i);
            if (refMatch) {
              var existingRef = decodeURIComponent(refMatch[2]);
              var delimiter = existingRef.charAt(existingRef.length - 1) === '|' ? '' : '|';
              if (existingRef.indexOf(newPart) === -1) {
                var updatedRef = encodeURIComponent(existingRef + delimiter + newPart);
                resultUrl = resultUrl.replace(/([?&])ref=[^&]*/i, '$1ref=' + updatedRef);
              }
            } else {
              var separator = resultUrl.indexOf('?') !== -1 ? '&' : '?';
              resultUrl += separator + 'ref=' + encodeURIComponent(newPart);
            }
          }

          // Apply ref rules
          if (!hasDelivery) appendToRef('delivery_time:1');
          if (!hasTopRated) appendToRef('seller_level:top_rated_seller');

          // Re-attach hash if it existed
          resultUrl += hashFragment;

          return resultUrl;
        }

        // Appcues event listener
        if (window.Appcues && window.Appcues.identify) {
          window.Appcues.on('all', function(e, a) {
            // Trigger when flow is completed AND flow name contains "Fast-Delivery-TRS"
            if (a && a.id === "flow_completed" && a.flowName && a.flowName.indexOf("Fast-Delivery-TRS") !== -1) {
              var newURL = buildFilteredURL();
              window.location.href = newURL;
            }
            // When flow name contains "Teaser", inject the shadow removal CSS
            if (a && a.flowName && a.flowName.indexOf("Teaser") !== -1) {
              injectCSS(
                "appcues-container:not(.appcues-fullscreen):not(.fullscreen)[data-pattern-type=shorty][data-position^=bottom] {box-shadow: none !important;}"
              );
            }
          });
        }
      })();
    `;

    // Execute the script
    const script = document.createElement('script');
    script.textContent = scriptContent;
    document.head.appendChild(script);
  } catch (error) {
    // Silent error handling for production
  }
},
    initializeAppcuesPro: () => {
  try {
    // Inject CSS first
    const css = `
            appcues-container {
                border-radius: 8px !important;
            }
            appcues-container[data-pattern-type=shorty][data-position="bottom"] {
                margin-left: 100px !important;
                bottom: 50px !important;
            }
        `;
    const style = document.createElement('style');
    style.type = 'text/css';
    style.innerHTML = css;
    document.head.appendChild(style);

    // Execute main script
    const scriptContent = `
            (function() {
                var injectCSS = function(css) {
                    var style = document.createElement('style');
                    style.type = 'text/css';
                    style.innerHTML = css;
                    document.head.appendChild(style);
                }

                var getAppcuesiFrame = function(){
                    var parentElement = document.querySelector('appcues-container');
                    if(parentElement){
                        var iframe = parentElement.querySelector('iframe');
                        return iframe;
                    } else {
                        return null;
                    }
                }

                var injectScriptIntoIframe = function(jsToInject) {
                    var iframe = getAppcuesiFrame();
                    if (iframe) {
                        var script = document.createElement('script');
                        script.innerHTML = jsToInject;
                        iframe.contentWindow.document.body.appendChild(script);
                    }
                };

                var sendCustomEvent = function(flowId, flowName){
                    var eventDetails = {
                        flowId: flowId,
                        flowName: flowName 
                    }
                    var customEvent = new CustomEvent('logAppcuesEvent', {
                        detail: eventDetails
                    })
                    window.dispatchEvent(customEvent)
                }

                if (Appcues && Appcues.identify) {
                    Appcues.on('all', function(e, a) {

                        if (
                            a &&
                            a.flowName &&
                            a.flowName.indexOf("Teaser") !== -1
                        ) {
                            injectCSS(
                                "appcues-container:not(.appcues-fullscreen):not(.fullscreen)[data-pattern-type=shorty][data-position^=bottom] {box-shadow: none !important;}"
                            );
                        }
                        
                        if (
                            a &&
                            a.id === "flow_completed" &&
                            a.flowName &&
                            a.flowName.indexOf("Expert-Sourcing-Drawer") !== -1
                        ) {
                            var openDrawerEvent = new CustomEvent('openSourcingDrawer', {
                                detail: {
                                    source: 'appcues',
                                    isOpen: true,
                                    autoOpen: false,
                                    setIsLoading: function(_) {}, // ← suppress alert
                                    enableGoBack: false,
                                    onClose: function() {
                                        // optionally suppress this too
                                    }
                                }
                            });

                            window.dispatchEvent(openDrawerEvent);
                        }
                        
                        if (
                            a &&
                            a.id === "flow_completed" &&
                            a.flowName &&
                            a.flowName.indexOf("Job-Post-Drawer") !== -1
                        ) {
                            var source = 'appcues+' + a.flowName;
                            var currencyCode = initialData && initialData.FiverrContext && initialData.FiverrContext.currency;

                            if (window.isBriefCreationDrawerLoaded && currencyCode) {
                                var event = new CustomEvent("openBriefCreationDrawer", {
                                    detail: {
                                        source: source,
                                        currency: currencyCode,
                                        isOpen: true,
                                        setIsLoading: function() {},
                                        onClose: function() {}
                                    }
                                });
                                window.dispatchEvent(event);
                            }
                        }
                        
                        if(a && a.id=="flow_started"){
                            sendCustomEvent(a.flowId, a.flowName)
                        }         
                        
                        if (
                            a && 
                            (a.flowId == "124cc70c-a8e6-4911-aedb-920fed835fb6" || 
                            a.flowId == "3560d5c4-152f-4e59-a10a-c5dfb8a39451" || 
                            a.flowId == "d3d72950-37b9-43fb-a227-fdad27fff342" || 
                            a.flowId == "dd526bda-30e6-40f8-8fa0-745b258584ad" || 
                            a.flowId == "58c927ef-2bc3-427d-9283-57f1b3c3b62b") && 
                            a.id == "flow_completed"
                        ) {
                            if (window.parent.adaEmbed) {
                                window.parent.adaEmbed.toggle();
                                window.parent.adaEmbed.setMetaFields({ campaign_source: a.flowName });
                            }
                        }

                        // Define the function to generate the new URL in a way supported by older JavaScript
                        var generateHourlyListingURL = "function generateHourlyListingURL(url) {var searchIndex = url.indexOf('?');var searchParams = searchIndex !== -1 ? url.substring(searchIndex) : '';var baseUrl = searchIndex !== -1 ? url.substring(0, searchIndex) : url;var expertListingsMatch = searchParams.match(/expert_listings=([^&]*)/);if (expertListingsMatch) {searchParams = searchParams.replace(/expert_listings=[^&]*/, 'expert_listings=true');} else {if (searchParams.length > 0) {searchParams += '&expert_listings=true';} else {searchParams = '?expert_listings=true';}}var hourlyRef = 'has_hourly%3Atrue';var refMatch = searchParams.match(/ref=([^&]*)/);if (refMatch) {var refValue = refMatch[1];if (refValue.indexOf(hourlyRef) === -1) {refValue += '%7C' + hourlyRef;searchParams = searchParams.replace(/ref=[^&]*/, 'ref=' + refValue);}} else {if (searchParams.length > 0) {searchParams += '&ref=' + hourlyRef;} else {searchParams = '?ref=' + hourlyRef;}}var newUrl = baseUrl + searchParams;return newUrl;}";

                        if (a && (
                            a.id == "step_started" && (
                            a.flowId == "352c6f2c-556b-491b-b057-f1d1331fb25d" || 
                            a.flowId == "a92908ce-e78a-4d78-ace6-e99d25159890")
                           ) || 
                            (a.id == "step_child_activated"
                              && a.stepChildId == "e6cc6bc2-7a9a-401f-8b20-6e83090404b0")
                        ) {
                            window.addEventListener("message", function(event) {
                              // Optionally check event.origin to ensure the message is from a trusted source
                              if (event.data && event.data.hourlyPromoTeaserURL) {
                               window.hourlyPromoTeaserURL = event.data.hourlyPromoTeaserURL;
                              }
                            });
                            var jsToInject = generateHourlyListingURL + 
                            "var button = document.querySelector('.appcues-button-success');" + 
                            "if (button) {" + 
                                "var parentUrl = window.parent.location.href;" + 
                                "var newUrl = generateHourlyListingURL(parentUrl);" + 
                                "window.parent.postMessage({ hourlyPromoTeaserURL: newUrl }, '*');" +
                                "button.addEventListener('click', function() {" + 
                                    "window.parent.location.href = newUrl;" + 
                                "});" + 
                            "} else {" + 
                            "}";
                            injectScriptIntoIframe(jsToInject);
                        }

                        if(a && a.flowId == "68c11bd4-35bd-46ad-ad09-a4811f1117ac"
                            && a.id == "flow_completed"
                            && !window.location.href.includes("hourly")){
                          if(window.parent.hourlyPromoTeaserURL){
                            window.location.href = window.parent.hourlyPromoTeaserURL
                          }
                        }
                        
                        if (
                            a && 
                            (a.flowId == "0edcab60-8316-487a-8655-c0532df957f5" || 
                             a.flowId == "f96e76c7-dcdc-445e-994b-f66358c3ae04" || 
                             a.flowId == "9124ffea-83ff-42df-ba69-3ca0e6abdab4") && 
                            a.id == "flow_completed"
                        ) {
                            var SOURCE = 'appcues-mp';
                            var HOME_HREF = 'https://pro.fiverr.com';
                            var EVENT_NAME = 'openFibMigration';
                            var onSuccess = function() { window.location.href = HOME_HREF; };
                            var onSkip = function() { return undefined; };
                            var onError = function() { return undefined; };
                            var onLoadError = function() { return undefined; };
                            
                            var event = new CustomEvent(EVENT_NAME, { 
                                detail: { 
                                    source: SOURCE, 
                                    onSuccess: onSuccess, 
                                    flowContext: {}, 
                                    onError: onError, 
                                    onSkip: onSkip, 
                                    onLoadError: onLoadError 
                                }
                            });

                            window.dispatchEvent(event);
                        }
                    })
                }
            })();
        `;

    // Execute the script
    const script = document.createElement('script');
    script.textContent = scriptContent;
    document.head.appendChild(script);
  } catch (error) {
    // Silent error handling for production
  }
},
    initializeChecklist: () => {
  try {
    // Execute the checklist styling script
    const scriptContent = `
            (function() {
              var bodyObserver = null;
              var processedChecklists = new WeakSet();
              var processedIframes = new WeakSet();

              function injectChecklistStyles(iframe, retries) {
                try {
                  // Skip if already processed
                  if (processedIframes.has(iframe)) return;
                  
                  var doc = iframe.contentDocument;
                  if (!doc || !doc.head) {
                    // Retry a few times if not ready
                    if (retries > 0) setTimeout(function() { injectChecklistStyles(iframe, retries - 1); }, 200);
                    return;
                  }
                  
                  // Mark as processed
                  processedIframes.add(iframe);
                  
                  iframe.style.setProperty('min-height', '80px');
                  var style = doc.createElement('style');
                  style.innerHTML =
                    '.beacon .badge { display: none !important; }' +
                    '.badge { display: none !important; }' +
                    '.checklist-main .checklist-body .item.completed a { color: #222325 !important; }'+
                    '.checklist-header { background-color: white !important; padding: 16px !important; }' +
                    '.checklist-header .header-content { display: flex !important; flex-direction: column !important; align-items: flex-start !important; }' +
                    '.checklist-header .header-content .row-top { display: flex !important; flex-direction: row !important; align-items: center !important; width: 100% !important; }' +
                    '.checklist-header .header-content .row-top::before { content: ""; display: inline-block !important; width: 48px !important; height: 48px !important; background-image: url("https://images.appcues.com/image/upload/v1753120663/131991/ff1abpox0cgt6msxb6dx.png") !important; background-size: contain !important; background-repeat: no-repeat !important; margin-right: 12px !important; vertical-align: middle !important; }' +
                    '.checklist-header .title { font-size: 16px !important; color: #222325 !important; font-family: Macan !important; font-weight: 700 !important; line-height: 22px !important; display: inline-block !important; vertical-align: middle !important; }' +
                    '.checklist-header .desc { font-size: 14px !important; font-family: Macan !important; font-weight: 400 !important; line-height: 22px !important; color: #62646A !important; margin-top: 8px !important; margin-left: 60px !important; }' +
                    '.checklist-header .progress-container { display: flex !important; align-items: center !important; width: 100% !important; }' +
                    '.checklist-header .progress-bar { width: 255px !important; height: 8px !important; background: #EFEFF0 !important; border-radius: 12px !important; overflow: hidden !important; display: block !important; position: relative !important; }' +
                    '.checklist-header .progress-bar-complete { background: #222325 !important; height: 8px !important; border-radius: 12px !important; display: block !important; }' +
                    '.checklist-header .completed-caption { color: #74767E !important; font-family: Macan, sans-serif !important; font-weight: 600 !important; font-size: 14px !important; line-height: 22px !important; margin-left: 4px !important; padding-right: 0px !important; }' +
                    '.badge { display: none !important; }' +
                    '.item p { font-size: 16px !important; color: #222325 !important; font-family: Macan !important; font-weight: 400 !important; line-height: 24px !important; }' +
                    '.checklist .checklist-body .item.completed a .checkmark { background-color: #222325 !important; border-color: #222325 !important; }' + '.checklist-main .checklist-body .item .checkmark { width: 16px !important; height: 16px !important; border: 2px solid #74767E !important; }' + '.checklist .checklist-body .item.completed a .checkmark svg { width: 8px !important; height: 12px !important; }' +
                    '.checklist-main { border-radius: 12px !important; margin-bottom: 30px !important; margin: 0 15px 15px !important; }' +
                    '.checklist-main .checklist-header { border-radius: 12px !important; border: none !important; }' +
                    '.checklist-main.expanded { bottom: 45px !important; }' +
                    '.checklist-main .checklist-body .item:hover:not(.actionless) g#Icon-Caret-Right {' +
                      'display: none !important;' +
                      'fill: transparent !important;' +
                      'stroke: transparent !important;' +
                      'opacity: 0 !important;' +
                    '}' +
                    '.header-content h3 { font-size: 16px !important; color: #222325 !important; font-family: Macan !important; font-weight: 700 !important; line-height: 22px !important; display: inline-block !important; vertical-align: middle !important; text-align: left !important; margin: 0px !important; }' + 
                    '.header-content p { font-size: 14px !important; font-family: Macan !important; font-weight: 400 !important; line-height: 22px !important; color: #62646A !important; margin-top: 8px !important; margin-bottom: 0px !important; text-align: left !important; }' +
                    '.checklist-header .checklist-congrats { background-color: #ffffff !important; text-align: left !important; }' +
                    '.minimize svg:focus { outline: none !important; box-shadow: none !important; }' +
                    '.minimize:focus { outline: none !important; box-shadow: none !important; }' +
                    '.items .item > a > svg { display: none !important; }' +
                    '.emoji { padding-bottom: 6px !important; }' +
                    '.dismiss-container { display: flex !important; width: 100% important; padding: 0px 16px 16px 16px !important; }' +
                    '.dismiss-button { background-color: #222325 !important; border-radius: 8px !important; padding: 10px 0px !important; width: 100% !important; border: 0px !important; cursor: pointer !important; color: #ffffff !important; font-weight: 600 !important; font-size: 14px !important; line-height: 16px !important; }' +
                    '.checklist-main g#Icon-Caret-Right, g#Icon-Caret-Right { display: none !important; }' +
                    '.appcues-checklist, body .appcues-checklist, html body .appcues-checklist {' +
                      'position: fixed !important;' +
                      'z-index: 1 !important;' +
                    '}';
                  doc.head.appendChild(style);

                  // Use a short delay to ensure DOM is ready for manipulations
                  setTimeout(function() {
                    try {
                      // After the checklist loads, wrap title in a div.row-top
                      var headerContent = doc.querySelector('.header-content');
                      var title = doc.querySelector('.title');
                      if (headerContent && title && !doc.querySelector('.row-top')) {
                        // Split the title text after "to"
                        var titleText = title.textContent;
                        var splitIndex = titleText.indexOf("to");
                        if (splitIndex !== -1) {
                          var before = titleText.slice(0, splitIndex + 2); // "Welcome to"
                          var after = titleText.slice(splitIndex + 2);     // " Fiverr Pro!"
                          title.innerHTML = before + '<br>' + after;
                        }
                        var rowTop = doc.createElement('div');
                        rowTop.className = 'row-top';
                        rowTop.appendChild(title);
                        headerContent.insertBefore(rowTop, headerContent.firstChild);
                      }

                      // Replace the inner SVG of the minimize button
                      var minimizeButton = doc.querySelector('.minimize');
                      if (minimizeButton && !minimizeButton.hasAttribute('data-styled')) {
                        minimizeButton.setAttribute('aria-label', 'Minimize checklist');
                        minimizeButton.setAttribute('role', 'button');
                        minimizeButton.setAttribute('tabindex', '-1');
                        minimizeButton.setAttribute('data-styled', 'true');
                        minimizeButton.style.visibility = 'visible';

                        var svg = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">' +
                                  '<path d="M17 7L12 12M12 12L7 17M12 12L17 17M12 12L7 7" stroke="#222325" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>' +
                                  '</svg>';
                        minimizeButton.innerHTML = '<div aria-hidden="true">' + svg + '</div>';
                      }

                      // Fix progress bar order: move completed-caption after progress-bar
                      var progressContainer = doc.querySelector('.progress-container');
                      if (progressContainer && !progressContainer.hasAttribute('data-fixed')) {
                        progressContainer.setAttribute('data-fixed', 'true');
                        var progressBar = progressContainer.querySelector('.progress-bar');
                        var completedCaption = progressContainer.querySelector('.completed-caption');
                        if (progressBar && completedCaption && completedCaption.previousElementSibling !== progressBar) {
                          progressContainer.appendChild(completedCaption); // Moves it after progressBar
                        }
                      }
                      
                      var congratsElement = doc.querySelector('.checklist-congrats');
                      
                      if(congratsElement && !congratsElement.hasAttribute('data-enhanced')) {
                        congratsElement.setAttribute('data-enhanced', 'true');
                        var completedProgressElement = document.createElement('div');
                        completedProgressElement.innerHTML = '<div class="progress-container"><span class="progress-bar"><span class="progress-bar-complete" style="width: 100%; background-color: white;"></span></span><span class="completed-caption">100%</span></div>';
                        headerContent.appendChild(completedProgressElement);
                      }
                      
                      var dismissLink = doc.querySelector('.dismiss-link');
                      
                      if(dismissLink && !dismissLink.hasAttribute('data-styled')) {
                        dismissLink.setAttribute('data-styled', 'true');
                        var svg = '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">' +
                        '<path d="M17 7L12 12M12 12L7 17M12 12L17 17M12 12L7 7" stroke="#222325" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>' +
                        '</svg>';
                        dismissLink.innerHTML = svg;
                      }
                      
                      var badge = doc.querySelector('.badge');
                      if(badge) badge.style.display = "none";
                    } catch (e) {
                      //console.warn('Error in DOM manipulation:', e);
                    }
                  }, 100);
                } catch (e) {
                  //console.warn('Error injecting checklist styles:', e);
                }
              }

              function setupChecklist(checklistContainer) {
                // Skip if already processed
                if (processedChecklists.has(checklistContainer)) return;
                processedChecklists.add(checklistContainer);
                
                // Set z-index and position for checklist and beacon
                checklistContainer.style.zIndex = "2";
                checklistContainer.style.position = "fixed";
                var appcuesBeacon = document.querySelector('.beacon');
                if(appcuesBeacon) {
                  appcuesBeacon.style.zIndex = "2";
                  appcuesBeacon.style.position = "fixed";
                }

                // Observe for new iframes inside this checklist
                var iframeObserver = new MutationObserver(function(mutations) {
                  mutations.forEach(function(mutation) {
                    mutation.addedNodes.forEach(function(node) {
                      if (node.tagName === 'IFRAME') {
                        node.addEventListener('load', function() {
                          injectChecklistStyles(node, 10);
                        });
                        // Also try immediate injection in case load already fired
                        setTimeout(function() { injectChecklistStyles(node, 5); }, 100);
                      }
                    });
                  });
                });
                iframeObserver.observe(checklistContainer, { childList: true, subtree: true });

                // Also inject if iframe already exists
                var iframe = checklistContainer.querySelector('iframe');
                if (iframe) {
                  iframe.addEventListener('load', function() {
                    injectChecklistStyles(iframe, 10);
                  });
                  // Try immediate injection in case load already fired
                  setTimeout(function() { injectChecklistStyles(iframe, 5); }, 100);
                }
              }

              function findAndProcessChecklists() {
                // Find all checklist elements (both visible and hidden)
                var checklists = document.querySelectorAll('appcues-checklist');
                checklists.forEach(function(checklist) {
                  setupChecklist(checklist);
                });
              }

              function startObservingChecklist() {
                // Disconnect previous observer if exists
                if (bodyObserver) bodyObserver.disconnect();

                bodyObserver = new MutationObserver(function(mutations) {
                  var shouldReprocess = false;
                  
                  mutations.forEach(function(mutation) {
                    mutation.addedNodes.forEach(function(node) {
                      if (node.tagName === 'APPCUES-CHECKLIST') {
                        setupChecklist(node);
                        shouldReprocess = true;
                      }
                      // Also check if it's a container that might have checklist inside
                      if (node.nodeType === Node.ELEMENT_NODE) {
                        var nestedChecklists = node.querySelectorAll('appcues-checklist');
                        if (nestedChecklists.length > 0) {
                          shouldReprocess = true;
                        }
                      }
                    });
                    
                    // Check for attribute changes that might indicate checklist state changes
                    if (mutation.type === 'attributes' && 
                        mutation.target.tagName === 'APPCUES-CHECKLIST') {
                      shouldReprocess = true;
                    }
                  });
                  
                  if (shouldReprocess) {
                    // Small delay to let DOM settle
                    setTimeout(findAndProcessChecklists, 100);
                  }
                });
                
                bodyObserver.observe(document.body, { 
                  childList: true, 
                  subtree: true, 
                  attributes: true,
                  attributeFilter: ['class', 'style', 'data-status']
                });

                // Process any existing checklists
                findAndProcessChecklists();
              }

              // Enhanced dataLayer monitoring
              var originalPush = window.dataLayer && window.dataLayer.push;
              if (window.dataLayer && typeof originalPush === "function") {
                window.dataLayer.push = function() {
                  var hasAppcuesEvent = false;
                  for (var i = 0; i < arguments.length; i++) {
                    var arg = arguments[i];
                    if (arg && typeof arg.event === "string" && 
                        (arg.event.match(/\\(Appcues\\)$/) || 
                         arg.event.includes('appcues') || 
                         arg.event.includes('checklist'))) {
                      hasAppcuesEvent = true;
                      break;
                    }
                  }
                  
                  var result = originalPush.apply(window.dataLayer, arguments);
                  
                  if (hasAppcuesEvent) {
                    // Clear processed sets to allow re-processing
                    processedChecklists = new WeakSet();
                    processedIframes = new WeakSet();
                    
                    // Re-observe and process
                    setTimeout(function() {
                      startObservingChecklist();
                    }, 100);
                  }
                  
                  return result;
                };
              }

              // Also listen for custom Appcues events
              document.addEventListener('appcues:all', function() {
                processedChecklists = new WeakSet();
                processedIframes = new WeakSet();
                setTimeout(startObservingChecklist, 100);
              });

              // Periodic check as fallback
              setInterval(function() {
                var checklists = document.querySelectorAll('appcues-checklist');
                if (checklists.length > 0) {
                  checklists.forEach(function(checklist) {
                    if (!processedChecklists.has(checklist)) {
                      setupChecklist(checklist);
                    }
                  });
                }
              }, 2000);

              // Start observing on page load
              if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', startObservingChecklist);
              } else {
                startObservingChecklist();
              }
            })();
        `;

    // Execute the script
    const script = document.createElement('script');
    script.textContent = scriptContent;
    document.head.appendChild(script);
  } catch (error) {
    // Silent error handling for production
  }
},
  };
